# Quarto / build artifacts
.quarto/
_freeze/
_preview/
_publish/
_build/
*_files/

# Rendered galleys (regenerated by CI; keep the repo source-only).
manuscripts/**/article.html
manuscripts/**/article.pdf
manuscripts/**/article.xml
manuscripts/**/article.tex
manuscripts/**/ojs/
manuscripts/**/_body.md
manuscripts/**/_refs.json

# OS / editor cruft
.DS_Store
Thumbs.db
*~
.idea/
.vscode/

# Python
__pycache__/
*.pyc
.venv/

/.quarto/
_preview_local/

# LaTeX intermediates
*.log
*.aux
*.bbl
*.bcf
*.blg
*.out
*.run.xml

# Office lock files
~$*
**/~$*

# Reimport proposals and local proof workspace state
manuscripts/**/.imports/
manuscripts/**/*.saving
# The original Stylometry archive and reference PDF are the tracked originals.
manuscripts/Stylometry/source/*
!manuscripts/Stylometry/source/accepted-source.zip
!manuscripts/Stylometry/source/accepted-proof.pdf
